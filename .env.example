# ==============================================================================
# Foundation ERP - Unified Single-Container Deployment Environment Variables
# Render Web Service Configuration (.env.example)
# NEVER commit real secrets or credentials to source control.
# ==============================================================================

# Database Connection (External PostgreSQL / Neon)
# Connects FastAPI exclusively to PostgreSQL via Neon Connection Pooler.
# The frontend NEVER connects directly to PostgreSQL.
DATABASE_URL=

# Backend Security / JWT Configuration
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# NextAuth Authentication Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Application & Environment Settings
APP_NAME=
APP_ENV=
DEBUG=

# CORS Configuration (Optional: comma-separated list of allowed origins)
CORS_ORIGINS=

# Cloudinary Storage Configuration (Optional: for logos, receipts, documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render Port Configuration
# Provided automatically by Render at runtime. Defaults to 10000 in Docker.
PORT=
